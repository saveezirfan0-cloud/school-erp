# Copy to .env.local (never commit real values; .env* is git-ignored).
#
# IMPORTANT: every variable starting with REACT_APP_ is PUBLIC. Create React
# App compiles it into the JavaScript that every visitor downloads. Never put
# a secret, a Supabase service_role key or any private token here.

# --- Supabase (required) -------------------------------------------------
# Supabase dashboard -> Project Settings -> API
REACT_APP_SUPABASE_URL=
# The "anon public" key only. It is meant to be public; the database's
# Row-Level Security policies are what protect the data.
REACT_APP_SUPABASE_ANON_KEY=

# --- WhatsApp reminders (optional, currently out of scope for hardening) ---
# WARNING: these are compiled into the public bundle, so the token is exposed
# to anyone who opens browser dev tools. Tracked in the audit as SEC-01 /
# DEP-10 / DEP-11; the intended fix is to move sending server-side.
REACT_APP_WHATSAPP_API_URL=
REACT_APP_WHATSAPP_PHONE_ID=
REACT_APP_WHATSAPP_TOKEN=
REACT_APP_CRON_SECRET=

# --- Build-time switches (set by `npm run build`, listed for reference) ---
# GENERATE_SOURCEMAP=false      do not publish source maps
# INLINE_RUNTIME_CHUNK=false    keep the runtime chunk external (lets the CSP
#                               drop 'unsafe-inline' for scripts later)
